{
  "name": "@doriedroc/ticketcine-core",
  "version": "1.0.0",
  "description": "Core utilities and shared setup",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [],
  "author": {
    "name": "Danilo Cordeiro",
    "email": "dev.danilocordeiro@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doriedroc/ticketcine-core.git"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "failComment": false
        }
      ]
    ]
  },
  "type": "module",
  "peerDependencies": {
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./prettier": "./src/prettier.config.mjs"
  },
  "devDependencies": {
    "semantic-release": "^25.0.9"
  }
}
